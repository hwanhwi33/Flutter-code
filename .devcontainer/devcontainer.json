{
	"name": "Flutter Dev Environment (Codespaces)",
	"build": {
	  "dockerfile": "Dockerfile"
	},
	"settings": {
	  "files.watcherExclude": {
		"**/target/**": true
	  }
	},
	"remoteUser": "codespace",
	"extensions": [
	  "dart-code.flutter",
	  "dart-code.dart-code"
	],
	"postCreateCommand": "flutter config --enable-web && flutter doctor"
  }
  